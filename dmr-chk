#!/bin/bash
# dmr-chk - WPSD System Dashboard & Gateway Protector
# Zielsystem: IP des WPSD-Hotspots

target_file="/etc/dmrgateway"
master_backup="/home/pi-star/dmrgateway.master"
current_month=$(date +'%Y-%m')
log_file="/home/pi-star/dmr-chk_log_${current_month}.txt"
archive_dir="/home/pi-star/dmr_log_archive"
alert_flag="/home/pi-star/.dmr_chk_alert"
bashrc_file="/home/pi-star/.bashrc"

sys_call=$(grep -m 1 "Callsign" /etc/mmdvmhost 2>/dev/null | cut -d'=' -f2 | tr -d ' \r\n')
sys_host=$(hostname)

# --- CRON INSTALLER ---
if [ "$1" == "install-cron" ]; then
    echo -e "\e[1;36m>> Installiere täglichen Cronjob (03:00 Uhr)...\e[0m"
    echo "0 3 * * * pi-star /home/pi-star/dmr-chk cron >/dev/null 2>&1" | sudo tee /etc/cron.d/dmr-chk >/dev/null
    
    if ! grep -q "DMR-CHK ALERT START" "$bashrc_file"; then
        cat << 'BASHRC' >> "$bashrc_file"
# --- DMR-CHK ALERT START ---
if [ -f /home/pi-star/.dmr_chk_alert ]; then
    echo -e "\e[1;31m\n========================================================\e[0m"
    echo -e "\e[1;31m ACHTUNG! DMR-CHK hat in der Nacht eine Änderung blockiert!\e[0m"
    echo -e "\e[1;31m Bitte führe sofort './dmr-chk' aus, um es zu prüfen!\e[0m"
    echo -e "\e[1;31m========================================================\n\e[0m"
fi
# --- DMR-CHK ALERT END ---
BASHRC
    fi
    echo -e "\e[1;32m[OK] Cronjob installiert und Login-Warnung aktiviert.\e[0m"
    exit 0
fi

if [ "$1" == "remove-cron" ]; then
    sudo rm -f /etc/cron.d/dmr-chk
    sed -i '/# --- DMR-CHK ALERT START ---/,/# --- DMR-CHK ALERT END ---/d' "$bashrc_file"
    rm -f "$alert_flag"
    echo -e "\e[1;32m[OK] Cronjob und Login-Warnung restlos entfernt.\e[0m"
    exit 0
fi

# --- 0. Log-Management & Rotation ---
manage_logs() {
    mkdir -p "$archive_dir" 2>/dev/null
    
    for old_log in /home/pi-star/dmr-chk_log_*.txt; do
        if [ -f "$old_log" ] && [ "$old_log" != "$log_file" ]; then
            archived_name="$(basename "$old_log" .txt).zip"
            zip -jq "${archive_dir}/${archived_name}" "$old_log"
            
            # Status aus dem alten Monat retten
            last_state=$(grep -E "\[OK\]|\[ACHTUNG\]" "$old_log" | tail -n 1)
            [ -z "$last_state" ] && last_state="Kein Status im alten Log."
            
            rm "$old_log"
            
            # Prominente Meldung ins NEUE Log schreiben
            echo -e "========================================================" >> "$log_file"
            echo "!! Monatswechsel !! NEUES-Logfile (${current_month}) gestartet." >> "$log_file"
            echo "Archiviertes Log: ${archived_name}" >> "$log_file"
            echo "Letzter Check Vormonat: ${last_state}" >> "$log_file"
            echo -e "========================================================\n" >> "$log_file"
        fi
    done
    
    find "$archive_dir" -name "*.zip" -type f -mtime +365 -exec rm {} \; -exec echo "$(date '+%Y-%m-%d %H:%M:%S') - SYSTEM: Archiv > 1 Jahr gelöscht: {}" >> "$log_file" \;
}

# Lösche das Alert-Flag, sobald der User das Skript interaktiv startet
if [ -t 1 ] && [ "$1" != "cron" ]; then
    rm -f "$alert_flag"
fi

# --- 1. Info-Dashboard (Die Analyse-Engine) ---
analyze_config() {
    last_run=$(grep "DMR-CHK ANALYSE START" "$log_file" 2>/dev/null | tail -n 2 | head -n 1 | awk -F' - ' '{print $2}')
    [ -z "$last_run" ] && last_run="Bisher keine Analyse im aktuellen Log."

    echo -e "\n\n\n========================================================"
    echo -e " DMR-CHK ANALYSE START - $(date '+%Y-%m-%d %H:%M:%S')"
    echo -e " Letzter Lauf: $last_run"
    echo -e "========================================================\n"

    echo -e "\e[1;36m=== 0. STATION & GATEWAY CONFIG ===\e[0m"
    echo -e "Station:    \e[1;33m${sys_call:-Unbekannt} - Hotspot ${sys_host}\e[0m"
    
    awk -F '=' -v q='"' '
    /^\[Info\]/ { in_info=1; in_voice=0; in_log=0; next }
    /^\[Voice\]/ { in_info=0; in_voice=1; in_log=0; next }
    /^\[Log\]/ { in_info=0; in_voice=0; in_log=1; next }
    /^\[/ { in_info=0; in_voice=0; in_log=0 }
    
    in_info && $1=="RXFrequency" { rx=$2 }
    in_info && $1=="TXFrequency" { tx=$2 }
    in_info && $1=="Latitude" { lat=$2 }
    in_info && $1=="Longitude" { lon=$2 }
    in_info && $1=="Location" { loc=$2; gsub(q, "", loc) }
    in_info && $1=="URL" { url=$2 }
    
    in_voice && $1=="Language" { lang=$2 }
    in_voice && $1=="Directory" { vdir=$2 }
    
    in_log && $1=="FilePath" { logp=$2 }
    
    END {
        if(rx != "") rx = sprintf("%.3f MHz", rx / 1000000);
        if(tx != "") tx = sprintf("%.3f MHz", tx / 1000000);
        printf "Standort:   \033[37m%s (Lat: %s, Lon: %s)\033[0m\n", loc, lat, lon
        printf "Frequenzen: \033[1;32mRX %s / TX %s\033[0m\n", rx, tx
        printf "QRZ/URL:    \033[1;34m%s\033[0m\n", url
        printf "Voice-Anns: \033[32m%s\033[0m (Pfad: %s)\n", lang, vdir
        printf "Log-Pfad:   \033[32m%s\033[0m\n", logp
    }' "$target_file"

    echo -e "\n\e[1;36m=== 1. WPSD SYSTEM-DATENBANKEN ===\e[0m"
    [ -f /usr/local/etc/DMRIds.dat ] && echo -e "DMR-IDs:       \e[1;32m$(wc -l < /usr/local/etc/DMRIds.dat) Einträge\e[0m (Stand: $(stat -c %y /usr/local/etc/DMRIds.dat | cut -d'.' -f1))"
    [ -f /usr/local/etc/TGList_BM.txt ] && echo -e "BM Talkgroups: \e[1;32m$(wc -l < /usr/local/etc/TGList_BM.txt) Einträge\e[0m"
    [ -f /usr/local/etc/TGList_DMRp.txt ] && echo -e "DMR+ TGs:      \e[1;32m$(wc -l < /usr/local/etc/TGList_DMRp.txt) Einträge\e[0m"
    [ -f /usr/local/etc/YSFHosts.txt ] && echo -e "YSF Räume:     \e[1;32m$(wc -l < /usr/local/etc/YSFHosts.txt) Einträge\e[0m"
    [ -f /usr/local/etc/DPlus_Hosts.txt ] && echo -e "D-Star Hosts:  \e[1;32m$(wc -l < /usr/local/etc/DPlus_Hosts.txt) Einträge\e[0m"
    
    next_update=$(systemctl list-timers wpsd-hostfile-update.timer 2>/dev/null | grep 'wpsd-hostfile-update.timer' | awk '{print $1" "$2" "$3}')
    echo -e "Nächstes Hostfile-Update: \e[1;33m${next_update:-Unbekannt}\e[0m"

    echo -e "\n\e[1;36m=== 2. WÄCHTER & LOG-STATUS ===\e[0m"
    last_check=$(grep -E "\[OK\]|\[ACHTUNG\]|RESTORE|UPDATE" "$log_file" 2>/dev/null | tail -n 1)
    if [ -z "$last_check" ]; then
        echo -e "\e[1;33mLogfile neu angelegt, noch keine Historie.\e[0m"
    else
        if echo "$last_check" | grep -q "\[OK\]"; then
            echo -e "Letzter Wächter-Check: \e[1;32m$last_check\e[0m"
        else
            echo -e "Letzter Wächter-Check: \e[1;31m$last_check\e[0m"
        fi
    fi

    echo -e "\n\e[1;36m=== 3. BRANDMEISTER DASHBOARD FAVORITEN ===\e[0m"
    bm_config="/etc/wpsd-bm-config.json"
    if [ -f "$bm_config" ]; then
        echo -e "\e[1;37mHINWEIS: Dies ist die im Dashboard hinterlegte Favoriten-Liste.\e[0m"
        echo -e "\e[1;37mUm zu sehen welche TGs live aktiv sind oder um Änderungen vorzunehmen:\e[0m"
        echo -e "\e[1;37mGehe im WPSD-Dashboard zu -> Admin -> Brandmeister Manager!\e[0m\n"
        
        grep -oP '"\d+":\{"slot":[^}]+\}' "$bm_config" | sed 's/[^0-9:]//g' | while read -r line; do
            tg=$(echo "$line" | cut -d':' -f1)
            tg_name=$(grep -E "^${tg};" /usr/local/etc/TGList_BM.txt | cut -d';' -f3)
            
            if [ -n "$tg_name" ]; then
                printf " \e[1;34m📌\e[0m %-15s %b\n" "TG $tg" "\e[32m($tg_name)\e[0m"
            else
                printf " \e[1;34m📌\e[0m %-15s %b\n" "TG $tg" "\e[1;41m[INOFFIZIELL / NICHT IN OFFIZIELLER LISTE]\e[0m"
            fi
        done
    fi

    echo -e "\n\e[1;36m=== 4. DMRGATEWAY STATUS-MATRIX ===\e[0m"
    awk -F '=' '
    BEGIN {
        skip_section = 0;
        while ((getline line < "/usr/local/etc/TGList_BM.txt") > 0) {
            split(line, a, ";"); tg_bm[a[1]] = a[3];
        }
        while ((getline line < "/usr/local/etc/TGList_DMRp.txt") > 0) {
            split(line, a, ","); tg_dmrp[a[1]] = a[2];
        }
    }
    /^\[/ {
        if (section != "" && has_enabled == 1 && skip_section == 0) {
            status_color = (enabled == 1) ? "\033[1;32m🟢 AKTIV  \033[0m" : "\033[1;31m🔴 INAKTIV\033[0m";
            printf "%s %-22s", status_color, section;
            if (name != "") printf " | %-20s", name;
            if (port != "") printf " | Port: %s", port;
            printf "\n";
            
            if (enabled == 1) {
                if (options != "") printf "%s\n", options;
                if (rules != "") printf "%s", rules;
                printf "\n";
            }
        }
        
        section = $0; enabled = ""; has_enabled = 0; name = ""; port = ""; options = ""; rules = "";
        if ($0 ~ /^\[Log\]/ || $0 ~ /^\[Voice\]/ || $0 ~ /^\[Info\]/ || $0 ~ /^\[General\]/) {
            skip_section = 1;
        } else {
            skip_section = 0;
        }
        next;
    }
    skip_section == 1 { next }
    
    $1 == "Enabled" || $1 == "Enable" { enabled = $2; has_enabled = 1 }
    $1 == "Name" { name = $2 }
    $1 == "Port" { port = $2 }
    
    $1 == "Options" { 
        opt_raw = $0
        opt_val = $0; sub(/^Options="/, "", opt_val); sub(/"$/, "", opt_val);
        split(opt_val, arr, ";");
        startref = ""; relink = ""; ts1 = ""; ts2 = "";
        for(i=1; i<=length(arr); i++) {
            split(arr[i],kv,"=");
            if (kv[1] == "StartRef" && kv[2] != "") startref = kv[2];
            if (kv[1] == "RelinkTime" && kv[2] != "") relink = kv[2];
            if (kv[1] ~ /^TS1_/ && kv[2] != "") ts1 = ts1 (ts1 ? ", " : "") kv[2];
            if (kv[1] ~ /^TS2_/ && kv[2] != "") ts2 = ts2 (ts2 ? ", " : "") kv[2];
        }
        options = "      \033[1;34m" opt_raw "\033[0m\n"
        options = options "      \033[33m↳ StartRef: " (startref?startref:"(Keiner)") 
        options = options " | Relink: " (relink?relink" Min":"(Aus)") 
        options = options " | TS1 Statisch: [" (ts1?ts1:"-") "]" 
        options = options " | TS2 Statisch: [" (ts2?ts2:"-") "]\033[0m"
    }
    
    $1 ~ /^(TGRewrite|SrcRewrite|PCRewrite|TypeRewrite)/ { 
        if ($2 != "") {
            rule_raw = $0
            split($0, parts, "=");
            rule_name = parts[1];
            split(parts[2], v, ",");
            
            range_in = v[2]; if (v[5]>1) range_in = v[2] " - " (v[2] + v[5] - 1);
            range_out = v[4]; if (v[5]>1) range_out = v[4] " - " (v[4] + v[5] - 1);
            
            type_str = "ID";
            if (rule_name ~ /^TG/) type_str = "Talkgroup(s)";
            if (rule_name ~ /^PC/) type_str = "Privatruf(e)";
            
            tg_name = (tg_bm[v[4]] != "") ? tg_bm[v[4]] : (tg_dmrp[v[4]] != "" ? tg_dmrp[v[4]] : "");
            name_suffix = (tg_name != "") ? " (" tg_name ")" : "";
            
            explanation = "Leitet " type_str " " range_in " vom Funkgerät (TS " v[1] ") ➔ Ins DMR-Netz (TS " v[3] ") als " type_str " " range_out name_suffix;
            rules = rules "      \033[36m" rule_raw "\033[0m\n      \033[33m↳ " explanation "\033[0m\n"
        }
    }
    
    $1 ~ /^PassAll/ {
        msg = ($1 ~ /TG/) ? "Gruppenrufe" : "Privatrufe"
        rules = rules "      \033[36m" $0 "\033[0m\n      \033[1;32m↳ INFO: Gewolltes Pass-Through für ALLE " msg "\033[0m\n"
    }
    
    END {
        if (section != "" && has_enabled == 1 && skip_section == 0) {
            status_color = (enabled == 1) ? "\033[1;32m🟢 AKTIV  \033[0m" : "\033[1;31m🔴 INAKTIV\033[0m";
            printf "%s %-22s", status_color, section;
            if (name != "") printf " | %-20s", name;
            if (port != "") printf " | Port: %s", port;
            printf "\n";
            if (enabled == 1) {
                if (options != "") printf "%s\n", options;
                if (rules != "") printf "%s", rules;
                printf "\n";
            }
        }
    }' "$target_file"
    
    echo -e "\n========================================================"
    echo -e " DMR-CHK ANALYSE ENDE - $(date '+%Y-%m-%d %H:%M:%S')"
    echo -e "========================================================\n\n\n"
}

# --- Kernlogik ---
manage_logs

# --- CRON AUTOMATION (03:00 Uhr Check) ---
if [ "$1" == "cron" ]; then
    if ! diff -q "$target_file" "$master_backup" > /dev/null; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - CRON - [ACHTUNG] Konfigurations-Abweichung entdeckt!" >> "$log_file"
        touch "$alert_flag"
    else
        echo "$(date '+%Y-%m-%d %H:%M:%S') - CRON - [OK] Konfiguration synchron." >> "$log_file"
    fi
    exit 0
fi

if [ "$1" == "info" ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - INFO - Dashboard-Analyse gestartet." >> "$log_file"
    output=$(analyze_config)
    echo -e "$output"
    echo -e "$output" | sed 's/\x1b\[[0-9;]*m//g' >> "$log_file"
    exit 0
fi

# --- WÄCHTER CHECK (Default Run) ---
echo -e "\n\n\n========================================================" | tee -a "$log_file"
echo -e " DMR-CHK WÄCHTER CHECK - $(date '+%Y-%m-%d %H:%M:%S')" | tee -a "$log_file"
echo -e "========================================================" | tee -a "$log_file"

if [ ! -f "$master_backup" ]; then
    echo -e "\e[1;36m>> Erstmaliges Backup wird erstellt: $master_backup\e[0m" | tee -a "$log_file"
    sudo cp "$target_file" "$master_backup"
    echo -e "\e[1;32m>> Logfile ($(basename "$log_file")) gestartet!\e[0m" | tee -a "$log_file"
    echo -e "\e[1;37m>> Es protokolliert künftig alle Aktionen, rotiert monatlich und archiviert sich selbst.\e[0m" | tee -a "$log_file"
    
    echo "INIT - Master Backup erstellt und Log-System aktiviert." >> "$log_file"
    echo -e "========================================================\n\n\n" | tee -a "$log_file"
    exit 0
fi

if diff -q "$target_file" "$master_backup" > /dev/null; then
    echo -e "\e[1;32m[OK]\e[0m Keine unautorisierten Änderungen in dmrgateway gefunden."
    echo "[OK] Keine unautorisierten Änderungen in dmrgateway gefunden." >> "$log_file"
    echo -e "========================================================\n\n\n" | tee -a "$log_file"
    exit 0
fi

echo -e "\e[1;31m[ACHTUNG]\e[0m Abweichung in $target_file erkannt!"
echo "[ACHTUNG] Abweichung in $target_file erkannt! WPSD hat überschrieben oder manuelle Änderung." >> "$log_file"
echo "WPSD hat die Datei überschrieben oder es gab manuelle Änderungen." 

while true; do
    echo "Was möchtest du tun?"
    echo " [D]iff    : Änderungen farbig anzeigen"
    echo " [R]estore : Master-Backup wiederherstellen"
    echo " [U]pdate  : Aktuelle Datei als neues Master-Backup speichern"
    echo " [I]gnore  : Nichts tun und beenden"
    read -p "Deine Wahl (D/R/U/I): " choice

    case "$choice" in
        [dD])
            echo -e "\n--- Detaillierte Änderungen (Rot = Alt / Grün = Neu) ---"
            diff -u "$master_backup" "$target_file" | awk '
                /^\+/ { print "\033[32m" $0 "\033[0m"; next }
                /^\-/ { print "\033[31m" $0 "\033[0m"; next }
                { print }'
            echo ""
            echo "Aktion: [D]iff im Terminal angezeigt." >> "$log_file"
            ;;
        [rR])
            echo -e "\n\e[1;33mFolgende unautorisierte Änderungen werden JETZT gelöscht und repariert:\e[0m"
            diff -u "$target_file" "$master_backup" | awk '
                /^\+/ { print "\033[32m" $0 "\033[0m"; next }
                /^\-/ { print "\033[31m" $0 "\033[0m"; next }
                { print }'
            echo ""
            
            echo -e "\e[1;36m>> Stoppe Funk-Dienste (Display meldet OFFLINE)...\e[0m"
            sudo systemctl stop dmrgateway.service mmdvmhost.service
            sleep 2
            
            echo -e "\e[1;36m>> Überschreibe Systemdatei mit Master-Backup...\e[0m"
            sudo cp "$master_backup" "$target_file"
            echo "RESTORE - Unautorisierte Änderungen gelöscht und Master wiederhergestellt." >> "$log_file"
            
            echo -e "\e[1;36m>> Starte Funk-Dienste neu (Display zeigt Initializing)...\e[0m"
            sudo systemctl start dmrgateway.service mmdvmhost.service
            sleep 2
            
            echo -e "\e[1;32m[OK] All Services restarted and running! Sicherer Zustand wiederhergestellt.\e[0m\n"
            echo -e "========================================================\n\n\n" | tee -a "$log_file"
            break
            ;;
        [uU])
            sudo cp "$target_file" "$master_backup"
            echo "UPDATE - Neues Master-Backup durch User angelegt." >> "$log_file"
            echo -e "\e[1;32mNeues Master-Backup gespeichert.\e[0m"
            echo -e "========================================================\n\n\n" | tee -a "$log_file"
            break
            ;;
        [iI])
            echo "Abbruch."
            echo "Aktion: Ignoriert und beendet." >> "$log_file"
            echo -e "========================================================\n\n\n" | tee -a "$log_file"
            break
            ;;
        *)
            echo "Ungültige Eingabe."
            ;;
    esac
done
